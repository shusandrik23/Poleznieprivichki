rules_version = '2';

// Правила доступа к данным YouBoost.
// Вставьте этот файл в консоли Firebase: Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // b есть в списке друзей у a
    function isFriend(a, b) { return exists(/databases/$(db)/documents/users/$(a)/friends/$(b)); }

    // Занятые ники: usernames/{ник} → { uid }
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn()
        && name.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == me();
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // Публичный профиль: только ник. Виден всем вошедшим (нужно для поиска друзей).
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['nickname'])
        && request.resource.data.nickname is string
        && getAfter(/databases/$(db)/documents/usernames/$(request.resource.data.nickname)).data.uid == me();
      allow delete: if signedIn() && uid == me();
    }

    // Поиск единомышленников: ник и серии тех, кто сам включил «показывать меня».
    match /discover/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && uid == me();
    }

    // Приглашения по ссылке (WhatsApp и т. п.). Код знает только тот, кому отправили ссылку.
    match /invites/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && code.size() >= 12
        && request.resource.data.from == me();
      allow delete: if signedIn() && resource.data.from == me();
    }

    // Приглашённые по ссылке новые пользователи: referrals/{новый пользователь} → { by: пригласивший }.
    // Создаётся один раз, при регистрации (когда профиля ещё нет), и только по настоящей ссылке пригласившего.
    match /referrals/{uid} {
      allow read: if signedIn() && (uid == me() || resource.data.by == me());
      allow create: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['by', 'code', 'createdAt'])
        && request.resource.data.by != me()
        && !exists(/databases/$(db)/documents/profiles/$(me()))
        && get(/databases/$(db)/documents/invites/$(request.resource.data.code)).data.from == request.resource.data.by;
      allow delete: if signedIn() && uid == me();
    }

    // Токены телефонов для пуш-уведомлений — только владельцу (серверная функция читает их в обход правил).
    match /pushTokens/{uid} {
      allow read, write: if signedIn() && uid == me();
    }

    // Серии по привычкам и настоящее имя (если разрешено). Видны только самому пользователю и его друзьям.
    match /stats/{uid} {
      allow read: if signedIn() && (uid == me() || isFriend(uid, me()));
      allow write: if signedIn() && uid == me();
    }

    // Личные данные (все отметки) — только владельцу.
    // YouBoost Plus: выдаёт только сервер (акции, оплата), владелец может читать.
    match /plus/{uid} {
      allow read: if signedIn() && uid == me();
      allow write: if false;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && uid == me();

      // Друзья. Запись появляется у обоих, когда получатель принимает заявку
      // или открывает ссылку-приглашение.
      match /friends/{other} {
        allow read: if signedIn() && uid == me();
        allow create: if signedIn() && (
          (me() == uid && exists(/databases/$(db)/documents/friendRequests/$(other + '_' + uid)))
          || (me() == other && exists(/databases/$(db)/documents/friendRequests/$(uid + '_' + other)))
          || ('invite' in request.resource.data && (
            (me() == uid && get(/databases/$(db)/documents/invites/$(request.resource.data.invite)).data.from == other)
            || (me() == other && get(/databases/$(db)/documents/invites/$(request.resource.data.invite)).data.from == uid)))
        );
        // друг может обновить в вашем списке только свой ник
        allow update: if signedIn() && me() == other
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname']);
        allow delete: if signedIn() && (me() == uid || me() == other);
      }
    }

    // Заявки в друзья: friendRequests/{от}_{кому}
    match /friendRequests/{id} {
      allow read: if signedIn() && (resource.data.from == me() || resource.data.to == me());
      allow create: if signedIn()
        && request.resource.data.from == me()
        && request.resource.data.to != me()
        && id == me() + '_' + request.resource.data.to
        && exists(/databases/$(db)/documents/profiles/$(request.resource.data.to));
      allow delete: if signedIn() && (resource.data.from == me() || resource.data.to == me());
    }

    // Турниры: участники и их отметки. Сами турниры описаны в js/tournaments.js.
    // checks — { 'номер дня': время сервера }. Отметку можно поставить или снять только за сегодня
    // (±1 день на часовые пояса) и только с временем сервера — задним числом не отметить.
    function dayNow() { return int(request.time.toMillis() / 86400000); }
    function todayKeys() { return [string(dayNow() - 1), string(dayNow()), string(dayNow() + 1)]; }
    function stampOk(after, added, k) { return !(k in added) || after[k] == request.time; }
    function checksOk() {
      let before = resource.data.get('checks', {});
      let after = request.resource.data.get('checks', {});
      let d = after.diff(before);
      return d.changedKeys().size() == 0
        && d.addedKeys().union(d.removedKeys()).hasOnly(todayKeys())
        && stampOk(after, d.addedKeys(), string(dayNow() - 1))
        && stampOk(after, d.addedKeys(), string(dayNow()))
        && stampOk(after, d.addedKeys(), string(dayNow() + 1));
    }
    function participantFieldsOk() {
      return request.resource.data.keys().hasOnly(['nickname', 'count', 'completed', 'failed', 'checks', 'joinedAt', 'updatedAt'])
        && request.resource.data.nickname is string
        && request.resource.data.count is int
        && request.resource.data.count >= 0
        && request.resource.data.count <= request.resource.data.get('checks', {}).size();
    }
    match /tournaments/{tid}/participants/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && uid == me() && participantFieldsOk()
        && request.resource.data.get('checks', {}).size() == 0;
      allow update: if signedIn() && uid == me() && participantFieldsOk() && checksOk();
      allow delete: if signedIn() && uid == me();
    }

    // Фото-подтверждения турнира: photos/{uid}_{номер дня}. Добавить можно только за сегодня.
    // Другие участники могут один раз отметить фото как неправдоподобное (flags).
    match /tournaments/{tid}/photos/{pid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'nickname', 'day', 'image', 'createdAt', 'flags', 'expires'])
        && request.resource.data.uid == me()
        && pid == me() + '_' + request.resource.data.day
        && request.resource.data.day in todayKeys()
        && request.resource.data.image is string
        && request.resource.data.image.size() < 400000
        && request.resource.data.createdAt == request.time
        && request.resource.data.flags == []
        && request.resource.data.expires is int
        && request.resource.data.expires >= int(request.resource.data.day)
        && request.resource.data.expires <= int(request.resource.data.day) + 400
        && exists(/databases/$(db)/documents/tournaments/$(tid)/participants/$(me()));
      allow update: if signedIn() && me() != resource.data.uid
        && exists(/databases/$(db)/documents/tournaments/$(tid)/participants/$(me()))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['flags'])
        && request.resource.data.flags.size() == resource.data.flags.size() + 1
        && request.resource.data.flags.hasAll(resource.data.flags)
        && me() in request.resource.data.flags
        && !(me() in resource.data.flags);
      // своё фото — в любой момент; чужое — после окончания турнира (expires — последний день турнира)
      allow delete: if signedIn() && (resource.data.uid == me() || dayNow() > resource.data.get('expires', 999999));
    }

    // Вызовы между двумя людьми: другом, человеком из поиска или по ссылке-приглашению.
    match /challenges/{id} {
      allow read: if signedIn() && me() in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.participants.size() == 2
        && request.resource.data.days is int
        && request.resource.data.days >= 1 && request.resource.data.days <= 365
        && (
          (request.resource.data.participants[0] == me()
            && request.resource.data.status == 'pending'
            && (isFriend(me(), request.resource.data.participants[1])
              || exists(/databases/$(db)/documents/discover/$(request.resource.data.participants[1]))))
          // приглашённый по ссылке сразу начинает вызов, который ему предложили
          || ('invite' in request.resource.data
            && request.resource.data.participants[1] == me()
            && request.resource.data.status == 'active'
            && get(/databases/$(db)/documents/invites/$(request.resource.data.invite)).data.from == request.resource.data.participants[0]
            && get(/databases/$(db)/documents/invites/$(request.resource.data.invite)).data.habitKey == request.resource.data.habitKey
            && get(/databases/$(db)/documents/invites/$(request.resource.data.invite)).data.days == request.resource.data.days
            && get(/databases/$(db)/documents/invites/$(request.resource.data.invite)).data.get('photoRequired', false) == request.resource.data.get('photoRequired', false))
        );
      allow update: if signedIn() && me() in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.days == resource.data.days
        && request.resource.data.habitKey == resource.data.habitKey
        && request.resource.data.get('photoRequired', false) == resource.data.get('photoRequired', false)
        && (
          // приглашённый принимает или отклоняет вызов
          (resource.data.status == 'pending'
            && me() == resource.data.participants[1]
            && request.resource.data.status in ['active', 'declined'])
          // каждый обновляет только свой прогресс
          || (request.resource.data.status == resource.data.status
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['progress'])
            && request.resource.data.progress.diff(resource.data.progress).affectedKeys().hasOnly([me()]))
        );
      allow delete: if signedIn() && me() in resource.data.participants;
    }

    // Фото в вызове с обязательным подтверждением: challenges/{id}/photos/{uid}_{день}.
    // Видят и добавляют только участники; добавить можно только за сегодня.
    match /challenges/{cid}/photos/{pid} {
      function challenge() { return get(/databases/$(db)/documents/challenges/$(cid)).data; }
      allow read: if signedIn() && me() in challenge().participants;
      allow create: if signedIn()
        && me() in challenge().participants
        && challenge().status == 'active'
        && request.resource.data.keys().hasOnly(['uid', 'day', 'image', 'createdAt', 'expires'])
        && request.resource.data.uid == me()
        && pid == me() + '_' + request.resource.data.day
        && request.resource.data.day in todayKeys()
        && request.resource.data.image is string
        && request.resource.data.image.size() < 400000
        && request.resource.data.createdAt == request.time
        && request.resource.data.expires is int
        && request.resource.data.expires >= int(request.resource.data.day)
        && request.resource.data.expires <= int(request.resource.data.day) + 400;
      // удалить может автор, любой участник (вызов закончился или удаляется) или кто угодно после срока
      allow delete: if signedIn() && (resource.data.uid == me() || dayNow() > resource.data.expires || me() in challenge().participants);
    }
  }
}
