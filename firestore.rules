rules_version = '2';

// Правила доступа к данным «Полезных привычек».
// Вставьте этот файл в консоли Firebase: Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // b есть в списке друзей у a
    function isFriend(a, b) { return exists(/databases/$(db)/documents/users/$(a)/friends/$(b)); }

    // Занятые ники: usernames/{ник} → { uid }
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn()
        && name.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == me();
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // Публичный профиль: только ник. Виден всем вошедшим (нужно для поиска друзей).
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['nickname'])
        && request.resource.data.nickname is string
        && getAfter(/databases/$(db)/documents/usernames/$(request.resource.data.nickname)).data.uid == me();
      allow delete: if signedIn() && uid == me();
    }

    // Поиск единомышленников: ник и серии тех, кто сам включил «показывать меня».
    match /discover/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && uid == me();
    }

    // Приглашения по ссылке (WhatsApp и т. п.). Код знает только тот, кому отправили ссылку.
    match /invites/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && code.size() >= 12
        && request.resource.data.from == me();
      allow delete: if signedIn() && resource.data.from == me();
    }

    // Серии по привычкам и настоящее имя (если разрешено). Видны только самому пользователю и его друзьям.
    match /stats/{uid} {
      allow read: if signedIn() && (uid == me() || isFriend(uid, me()));
      allow write: if signedIn() && uid == me();
    }

    // Личные данные (все отметки) — только владельцу.
    match /users/{uid} {
      allow read, write: if signedIn() && uid == me();

      // Друзья. Запись появляется у обоих, когда получатель принимает заявку
      // или открывает ссылку-приглашение.
      match /friends/{other} {
        allow read: if signedIn() && uid == me();
        allow create: if signedIn() && (
          (me() == uid && exists(/databases/$(db)/documents/friendRequests/$(other + '_' + uid)))
          || (me() == other && exists(/databases/$(db)/documents/friendRequests/$(uid + '_' + other)))
          || ('invite' in request.resource.data && (
            (me() == uid && get(/databases/$(db)/documents/invites/$(request.resource.data.invite)).data.from == other)
            || (me() == other && get(/databases/$(db)/documents/invites/$(request.resource.data.invite)).data.from == uid)))
        );
        // друг может обновить в вашем списке только свой ник
        allow update: if signedIn() && me() == other
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname']);
        allow delete: if signedIn() && (me() == uid || me() == other);
      }
    }

    // Заявки в друзья: friendRequests/{от}_{кому}
    match /friendRequests/{id} {
      allow read: if signedIn() && (resource.data.from == me() || resource.data.to == me());
      allow create: if signedIn()
        && request.resource.data.from == me()
        && request.resource.data.to != me()
        && id == me() + '_' + request.resource.data.to
        && exists(/databases/$(db)/documents/profiles/$(request.resource.data.to));
      allow delete: if signedIn() && (resource.data.from == me() || resource.data.to == me());
    }

    // Турниры: участники и их прогресс. Сами турниры описаны в js/tournaments.js.
    match /tournaments/{tid}/participants/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['nickname', 'count', 'completed', 'failed', 'joinedAt', 'updatedAt'])
        && request.resource.data.nickname is string
        && request.resource.data.count is int
        && request.resource.data.count >= 0 && request.resource.data.count <= 366;
      allow delete: if signedIn() && uid == me();
    }

    // Вызовы между двумя людьми: другом, человеком из поиска или по ссылке-приглашению.
    match /challenges/{id} {
      allow read: if signedIn() && me() in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.participants.size() == 2
        && request.resource.data.days is int
        && request.resource.data.days >= 1 && request.resource.data.days <= 365
        && (
          (request.resource.data.participants[0] == me()
            && request.resource.data.status == 'pending'
            && (isFriend(me(), request.resource.data.participants[1])
              || exists(/databases/$(db)/documents/discover/$(request.resource.data.participants[1]))))
          // приглашённый по ссылке сразу начинает вызов, который ему предложили
          || ('invite' in request.resource.data
            && request.resource.data.participants[1] == me()
            && request.resource.data.status == 'active'
            && get(/databases/$(db)/documents/invites/$(request.resource.data.invite)).data.from == request.resource.data.participants[0]
            && get(/databases/$(db)/documents/invites/$(request.resource.data.invite)).data.habitKey == request.resource.data.habitKey
            && get(/databases/$(db)/documents/invites/$(request.resource.data.invite)).data.days == request.resource.data.days)
        );
      allow update: if signedIn() && me() in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.days == resource.data.days
        && request.resource.data.habitKey == resource.data.habitKey
        && (
          // приглашённый принимает или отклоняет вызов
          (resource.data.status == 'pending'
            && me() == resource.data.participants[1]
            && request.resource.data.status in ['active', 'declined'])
          // каждый обновляет только свой прогресс
          || (request.resource.data.status == resource.data.status
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['progress'])
            && request.resource.data.progress.diff(resource.data.progress).affectedKeys().hasOnly([me()]))
        );
      allow delete: if signedIn() && me() in resource.data.participants;
    }
  }
}
